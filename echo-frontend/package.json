{
  "name": "online-chat-room",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@uppy/core": "^5.2.0",
    "@uppy/tus": "^5.1.1",
    "axios": "^1.7.2",
    "dompurify": "^3.4.13",
    "element-plus": "^2.7.7",
    "marked": "^12.0.2",
    "pinia": "^2.1.7",
    "vue": "^3.4.29",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.echo.chatroom",
    "productName": "EchoChat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
